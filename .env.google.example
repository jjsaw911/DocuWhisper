# Core runtime
NODE_ENV=production
PORT=8080
APP_BASE_URL=https://docuwhisper.com
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
SESSION_SECRET=replace-with-long-random-secret

# Preferred production web auth
IDENTITY_PROJECT_ID=your-gcp-project-id
IDENTITY_API_KEY=AIza...
IDENTITY_AUTH_DOMAIN=your-project.firebaseapp.com
IDENTITY_APP_ID=1:1234567890:web:abcdef
# Optional if you use Identity Platform multi-tenancy
# IDENTITY_TENANT_ID=

# AI provider
OPENAI_API_KEY=sk-...
# Optional: custom OpenAI-compatible endpoint
# OPENAI_BASE_URL=
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# Mobile direct tester login (bypasses Replit auth)
MOBILE_TEST_LOGIN_ENABLED=true
MOBILE_TEST_USERNAME=reviewer
MOBILE_TEST_PASSWORD=change-this
MOBILE_AUTH_REDIRECT_ALLOWLIST=docuwhisper://auth/callback

# Optional emergency fallback login
# Keep this for break-glass admin access only after Identity Platform is live.
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_USERNAME=admin
LOCAL_AUTH_PASSWORD=change-this
LOCAL_AUTH_USER_EMAIL=admin@docuwhisper.com

# Stripe (recommended on Google)
STRIPE_PUBLISHABLE_KEY=pk_...
STRIPE_SECRET_KEY=sk_...

# Optional email invites
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=DocuWhisper <noreply@docuwhisper.com>

# Optional local transcription provider
# TRANSCRIPTION_PROVIDER=local
# LOCAL_STT_URL=http://127.0.0.1:9000
# LOCAL_STT_API_KEY=
